# --- App ---
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://voicefirst:voicefirst@localhost:5432/voicefirst?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-at-least-16-chars
JWT_REFRESH_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=15

# --- Confirmation drafts ---
CONFIRMATION_TTL_MINUTES=30

# --- Storage (audio files) ---
STORAGE_PROVIDER=local   # local | supabase
STORAGE_LOCAL_DIR=./storage/audio
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=audio
AUDIO_MAX_SIZE_BYTES=25000000
AUDIO_RETENTION_DAYS=7

# --- Voice AI ---
VOICE_AI_PROVIDER=mock   # mock | gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp Cloud API ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200

# --- Error tracking (optional) ---
# SENTRY_DSN=